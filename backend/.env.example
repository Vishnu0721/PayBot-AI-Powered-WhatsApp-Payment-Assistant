PORT=3000
FRONTEND_URL=http://localhost:5173

MONGODB_URI=mongodb://127.0.0.1:27017/paybot

JWT_SECRET=change-this-to-a-long-random-secret
OTP_PEPPER=change-this-to-another-long-random-secret
# Optional dedicated key for encrypting per-merchant Razorpay secrets (falls back to JWT_SECRET)
CREDENTIALS_ENCRYPTION_KEY=

# Keep true until Razorpay TEST + WhatsApp Cloud are filled, then: npm run live:enable
DEMO_MODE=true
OTP_DEMO_MODE=true

# Free OTP: whatsapp (Meta Cloud API). Paid/optional: msg91 | twilio
OTP_PROVIDER=whatsapp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# Razorpay test keys first (rzp_test_…). Webhook secret required for LIVE.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
# Approved Authentication template name (recommended for reliable OTP)
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en
# Auth templates: url (default) | otp (copy-code) | none (body only)
WHATSAPP_OTP_TEMPLATE_BUTTON=url
# Live customer payment requests: body params merchant, amount, description, url
WHATSAPP_PAYMENT_TEMPLATE_NAME=
WHATSAPP_PAYMENT_TEMPLATE_LANGUAGE=en

# Parser: rules (default) | llm (optional OpenAI-compatible API)
PARSER_PROVIDER=rules
PARSER_LLM_API_KEY=
PARSER_LLM_BASE_URL=https://api.openai.com/v1
PARSER_LLM_MODEL=gpt-4o-mini

# Auto reminders for PENDING payments (off by default)
REMINDERS_ENABLED=false
REMINDER_AFTER_HOURS=24
REMINDER_INTERVAL_HOURS=24
REMINDER_MAX_COUNT=2
REMINDER_POLL_MS=300000

# Recurring collection worker (creates PENDING payments on schedule)
RECURRING_ENABLED=true
RECURRING_POLL_MS=300000

# Only razorpay is supported today
PAYMENT_PROVIDER=razorpay
